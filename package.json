{
  "name": "fastforward",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --project=!e2e --project=!fidelity",
    "test:e2e": "vitest run --project=e2e",
    "typecheck": "tsc -b",
    "fidelity": "vitest run --project fidelity",
    "demo": "npm run build && npm run build -w @fastforward/web && node scripts/start-hosted.mjs --run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
